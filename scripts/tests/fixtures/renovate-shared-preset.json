{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "assignees": ["ChrisLauinger77"],
  "reviewers": ["ChrisLauinger77"],
  "prConcurrentLimit": 5,
  "timezone": "Europe/Berlin",
  "schedule": ["* * * * 6"],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * 1-7 * 6"]
  },
  "packageRules": [
    {
      "description": "Group non-major dependency updates",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Non-major dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major", "minor", "patch", "digest", "pinDigest"],
      "groupName": "GitHub Actions"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "SHA-pinned GitHub Actions do not require a release age delay",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "minimumReleaseAge": null
    },
    {
      "description": "Follow the Claude Code Action version tag without pinning its digest",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["anthropics/claude-code-action"],
      "pinDigests": false
    }
  ]
}
